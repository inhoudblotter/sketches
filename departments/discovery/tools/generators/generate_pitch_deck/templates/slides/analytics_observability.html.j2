<div class="embla__slide">
  <div class="slide-content flex flex-col items-start text-left sm:items-center sm:text-center justify-center">
    <h2 class="w-full">Наблюдаемость (Observability)</h2>
    {% if scope_analytics.observability %}
    <div class="max-w-xl mb-8 px-2">
      <span class="text-xs font-bold uppercase tracking-widest block mb-3" style="font-family: var(--family-mono); color: #60a5fa;">North Star Metric</span>
      <p class="text-base sm:text-xl font-light leading-relaxed m-0" style="color: #eee;">{{ scope_analytics.observability.north_star_metric }}</p>
    </div>
    <div class="flex items-center justify-start sm:justify-center flex-wrap gap-6 sm:gap-10">
      <div class="text-center">
        <div class="metric-value text-blue mb-1" style="font-size: clamp(2rem, 7vw, 3.4rem);">{{ scope_analytics.observability.kpi_count }}</div>
        <div class="metric-label">KPI</div>
      </div>
      <div class="w-px h-12 sm:h-14" style="background: #333;"></div>
      <div class="text-center">
        <div class="metric-value mb-1" style="font-size: clamp(2rem, 7vw, 3.4rem); color: #facc15;">{{ scope_analytics.observability.critical_events_count }}</div>
        <div class="metric-label">Critical Events</div>
      </div>
      {% if scope_analytics.total_metrics_count %}
      <div class="w-px h-12 sm:h-14" style="background: #333;"></div>
      <div class="text-center">
        <div class="metric-value mb-1" style="font-size: clamp(2rem, 7vw, 3.4rem); color: #4ade80;">{{ scope_analytics.total_metrics_count }}</div>
        <div class="metric-label">Метрик приёмки (MVP)</div>
      </div>
      {% endif %}
    </div>
    {% else %}
    <div class="metric-card" style="border-left: 4px solid #60a5fa; display: inline-block; padding: 30px 60px;">
      <div class="metric-value text-blue" style="font-size: 3rem;">{{ scope_analytics.total_metrics_count }}</div>
      <div class="metric-label">Определено метрик приемки (MVP)</div>
    </div>
    {% endif %}
  </div>
</div>
