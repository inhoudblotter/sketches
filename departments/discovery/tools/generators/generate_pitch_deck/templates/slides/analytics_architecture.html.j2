<div class="embla__slide">
  <div class="slide-content">
    <h2>Архитектурная сложность и охват (Complexity & Scope)</h2>
    <p class="text-zinc-400 mb-6">Оценка платформ, связности доменов и сложности пользовательских сценариев.</p>
    {% set flow_metrics = scope_analytics.flow_metrics | default({}, true) %}
    {% set domain_coupling = scope_analytics.domain_coupling | default({}, true) %}
    
    <div class="flex flex-col gap-5">

      <!-- Platforms Full Width Row -->
      <div class="metric-card border-l-4 border-l-blue-400 mb-0 px-5 py-4">
        <div class="metric-label mb-3">Целевые платформы (Target Platforms)</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
          {% for platform in scope_analytics.platforms %}
            <div class="text-sm bg-[#222] border border-[#444] px-3 py-2 rounded text-gray-200 flex items-center justify-center text-center">
              {{ platform.name }}
            </div>
          {% else %}
            <div class="text-sm text-gray-200">{{ scope_analytics.platform_count }} платформ</div>
          {% endfor %}
        </div>
      </div>

      <!-- Metrics Row -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {% set flows = flow_metrics.total_flows | default(0) %}
        {% set states = flow_metrics.total_states | default(0) %}
        {% set states_per_flow = (states / flows) | round(1) if flows > 0 else 0 %}
        
        <div class="metric-card border-l-4 border-l-yellow-400 mb-0 px-5 py-4">
          <div class="metric-value text-yellow-400 text-3xl mb-1">{{ states_per_flow }}</div>
          <div class="metric-label">Плотность логики (States per Flow)</div>
          <div class="metric-sub mt-2 text-xs text-zinc-400 leading-relaxed">
            {% if states_per_flow > 5 %}
              Высокая плотность: говорит о глубоком и сложном продукте с ветвлениями.
            {% else %}
              Простой транзакционный опыт с короткими линейными сценариями.
            {% endif %}
            ({{ flows }} flows / {{ states }} states)
          </div>
        </div>
        
        {% set error_states = flow_metrics.total_shared_error_states | default(0) %}
        {% set error_rate = ((error_states / states) * 100) | round(1) if states > 0 else 0 %}
        <div class="metric-card border-l-4 border-l-red-400 mb-0 px-5 py-4">
          <div class="metric-value text-red-400 text-3xl mb-1">{{ error_rate }}%</div>
          <div class="metric-label">Сценарии сбоев (Error Rate)</div>
          <div class="metric-sub mt-2 text-xs text-zinc-400 leading-relaxed">
            {{ error_rate }}% архитектуры заложено на обработку краевых случаев и отказоустойчивость ({{ error_states }} shared states).
          </div>
        </div>
      </div>

      <!-- Graph -->
      <div class="bg-[#111] p-5 border border-[#333] flex flex-col items-center">
        <h3 class="mb-4 text-lg text-white text-left w-full">Связность доменов (Domain Coupling)</h3>
        <div class="w-full overflow-x-auto">
          <div class="mermaid bg-transparent w-full flex justify-center items-center min-w-[300px]">
%%{init: {'theme':'dark', 'themeVariables': { 'darkMode': true, 'background': 'transparent' }}}%%
graph TD;
{% for domain, metrics in domain_coupling.items() %}
{% set depends_count = (metrics.depends_on | default({}, true)).values() | map('length') | sum %}
{% set used_by_count = (metrics.used_by | default({}, true)).values() | map('length') | sum %}
{% if used_by_count > 3 %}
classDef bottleneck_{{ loop.index }} fill:#7f1d1d,stroke:#f87171,color:#fff,stroke-width:2px;
{{ domain }}:::bottleneck_{{ loop.index }};
{% elif depends_count > 3 %}
classDef complex_{{ loop.index }} fill:#713f12,stroke:#facc15,color:#fff,stroke-width:2px;
{{ domain }}:::complex_{{ loop.index }};
{% else %}
classDef normal_{{ loop.index }} fill:#1f2937,stroke:#4b5563,color:#fff;
{{ domain }}:::normal_{{ loop.index }};
{% endif %}
{% for dep_domain, deps in (metrics.depends_on | default({}, true)).items() %}
{{ domain }} --> {{ dep_domain }};
{% endfor %}
{% endfor %}
          </div>
        </div>
      </div>
      
    </div>
  </div>
</div>
