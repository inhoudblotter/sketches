{% import "screens/_macros.html.j2" as ui %}
{% call ui.page() %}
    <div class="mb-8">
      <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">Playbook Analytics</h2>
      <p class="text-gray-400 text-sm">Overview of required skills, their agent subscriptions, and cross-references between playbooks.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
      {% for pb in report.playbooks %}
      <div class="bg-venture-dark border border-gray-800 rounded-lg p-5 shadow-lg relative group hover:border-neon-magenta transition-colors">
        
        <div class="flex justify-between items-start mb-4">
          <div class="text-sm font-semibold text-neon-magenta break-all truncate pr-2" title="{{ pb.name }}">
            {{ pb.name.split('/')[-1] }}
          </div>
          <div class="text-xs text-gray-500 whitespace-nowrap bg-gray-900 px-2 py-1 rounded">
            {{ pb.size_kb }} KB
          </div>
        </div>

        <div class="text-xs text-gray-400 mb-3 font-mono truncate" title="{{ pb.name }}">
          {{ pb.name }}
        </div>

        <div class="flex items-center justify-between border-t border-gray-800 pt-3 mb-2">
          <span class="text-xs font-semibold text-gray-300 uppercase tracking-wider">Subscribers</span>
          {{ ui.count_badge(pb.subscribers | length, "cyan") }}
        </div>
        
        <div class="max-h-32 overflow-y-auto pr-2 custom-scrollbar">
          <ul class="flex flex-col gap-1.5">
            {% for sub in pb.subscribers %}
            <li class="text-xs text-gray-400 bg-gray-900/50 px-2 py-1.5 rounded flex items-center before:content-[''] before:w-1.5 before:h-1.5 before:bg-neon-blue before:rounded-full before:mr-2 before:inline-block border border-gray-800/50 hover:border-gray-700 transition-colors">
              {{ sub }}
            </li>
            {% endfor %}
          </ul>
        </div>

        <!-- Cross-references (progressive disclosure: collapsed until opened) -->
        {% if pb.references or pb.referenced_by %}
        <details class="mt-3 pt-3 border-t border-gray-800">
          <summary class="cursor-pointer list-none flex items-center justify-between text-xs font-semibold text-gray-300 uppercase tracking-wider">
            <span class="flex items-center gap-1.5">
              <i data-lucide="git-branch" class="w-3.5 h-3.5"></i>
              See also
            </span>
            <span class="flex items-center gap-2">
              <span class="bg-gray-800 text-gray-300 text-[10px] font-bold px-2 py-0.5 rounded-full">{{ (pb.references|length) + (pb.referenced_by|length) }}</span>
              <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-gray-500"></i>
            </span>
          </summary>
          <div class="mt-2 flex flex-col gap-2">
            {% if pb.references %}
            <div>
              <div class="text-[10px] text-gray-500 uppercase mb-1">References ({{ pb.references|length }})</div>
              <div class="flex flex-wrap gap-1">
                {% for r in pb.references %}
                <span class="text-[10px] px-1.5 py-0.5 bg-gray-900 text-neon-cyan border border-gray-800 rounded truncate max-w-[150px]" title="{{ r }}">{{ r.split('/')[-1] }}</span>
                {% endfor %}
              </div>
            </div>
            {% endif %}
            {% if pb.referenced_by %}
            <div>
              <div class="text-[10px] text-gray-500 uppercase mb-1">Referenced by ({{ pb.referenced_by|length }})</div>
              <div class="flex flex-wrap gap-1">
                {% for r in pb.referenced_by %}
                <span class="text-[10px] px-1.5 py-0.5 bg-gray-900 text-neon-magenta border border-gray-800 rounded truncate max-w-[150px]" title="{{ r }}">{{ r.split('/')[-1] }}</span>
                {% endfor %}
              </div>
            </div>
            {% endif %}
          </div>
        </details>
        {% endif %}
      </div>
      {% endfor %}
    </div>

    {% if not report.playbooks %}
    {{ ui.empty_state("book-open", "No playbooks found in the pipeline.") }}
    {% endif %}
{% endcall %}
