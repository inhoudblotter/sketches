// 1. Build Graphology Nodes and Edges

const artifactMeta = {};
data.edges.forEach(e => {
  if (e.edge_type === 'loads_skill') return; // skip playbooks
  if (e.source.includes('contracts/') || e.target.includes('contracts/')) return; // skip contracts
  if (e.source.includes('playbooks/') || e.target.includes('playbooks/')) return;

  if (e.edge_type === 'writes' || e.edge_type === 'reads' || e.edge_type === 'produces') {
    const artId = (e.edge_type === 'reads') ? e.source : e.target;
    if (!artifactMeta[artId]) artifactMeta[artId] = { exists: true };
  }
});

// Linters never appear on the graph as nodes — validation is surfaced as a
// color on the artifact itself instead.
const lockedArtifacts = new Map(); // artId -> [linter names]
const artifactFlags = new Map();   // artId -> ArtifactNode (no_producer/dead_end/exists)
(data.artifacts || []).forEach(a => {
  if (a.locked) lockedArtifacts.set(a.path, a.validated_by || []);
  artifactFlags.set(a.path, a);
});

const agentIds = new Set(data.agents.map(a => a.name));
const agentByName = {};
data.agents.forEach(a => { agentByName[a.name] = a; });
const toolMeta = {};
(data.tools || []).forEach(t => { toolMeta[t.name] = t; });

// --- Precompute writers/readers/subscribers, used for both sizing and criticality ---
const artifactWriters = {};   // artifact -> Set(agent) — direct writes only
const artifactReaders = {};   // artifact -> Set(agent/consumer)
const toolUsers = {};         // tool name -> Set(agent) that call it directly
const callersOfTool = {};     // tool name -> Set(tool names) that call it
const delegateTargets = new Set(); // subagents that are actually delegated to by someone

data.edges.forEach(e => {
  if (e.edge_type === 'uses_tool') {
    if (!toolUsers[e.target]) toolUsers[e.target] = new Set();
    toolUsers[e.target].add(e.source);
  }
  if (e.edge_type === 'calls_tool') {
    if (!callersOfTool[e.target]) callersOfTool[e.target] = new Set();
    callersOfTool[e.target].add(e.source);
  }
  if (e.edge_type === 'delegates') {
    delegateTargets.add(e.target);
  }
});

const blastRadiusCache = {};
function toolBlastRadius(toolName, seen) {
  seen = seen || new Set();
  if (seen.has(toolName)) return new Set();
  seen.add(toolName);
  if (blastRadiusCache[toolName]) return blastRadiusCache[toolName];
  const users = new Set(toolUsers[toolName] || []);
  (callersOfTool[toolName] || []).forEach(callerTool => {
    toolBlastRadius(callerTool, seen).forEach(u => users.add(u));
  });
  blastRadiusCache[toolName] = users;
  return users;
}

data.edges.forEach(e => {
  if (e.edge_type === 'writes') {
    if (!artifactWriters[e.target]) artifactWriters[e.target] = new Set();
    artifactWriters[e.target].add(e.source);
  }
  if (e.edge_type === 'produces') {
    if (!artifactWriters[e.target]) artifactWriters[e.target] = new Set();
    toolBlastRadius(e.source).forEach(a => artifactWriters[e.target].add(a));
  }
  if (e.edge_type === 'reads') {
    if (!artifactReaders[e.source]) artifactReaders[e.source] = new Set();
    // if target is a tool, add the agents that call it. Otherwise, target is an agent
    if (toolMeta[e.target] || toolUsers[e.target] || callersOfTool[e.target]) {
        toolBlastRadius(e.target).forEach(a => artifactReaders[e.source].add(a));
    } else {
        artifactReaders[e.source].add(e.target);
    }
  }
});

function subscriberCount(artId) {
  return artifactReaders[artId] ? artifactReaders[artId].size : 0;
}

// Agent "output significance" = total subscribers across everything it produces,
// whether written directly, generated by a tool it calls (agent -> tool -> file),
// or produced by a subagent it delegates to. This is what makes hub agents that
// feed many downstream files/subagents visually stand out.
const agentOutputSignificance = {};
data.edges.forEach(e => {
  if (e.edge_type === 'writes') {
    agentOutputSignificance[e.source] = (agentOutputSignificance[e.source] || 0) + subscriberCount(e.target);
  }
  if (e.edge_type === 'produces') {
    const subs = subscriberCount(e.target);
    (toolUsers[e.source] || []).forEach(agent => {
      agentOutputSignificance[agent] = (agentOutputSignificance[agent] || 0) + subs;
    });
  }
});
// Roll subagent significance up into their orchestrator (an orchestrator's
// importance includes what its subagents produce on its behalf).
const delegatesTo = {}; // orchestrator -> [subagent]
data.edges.forEach(e => {
  if (e.edge_type === 'delegates') {
    (delegatesTo[e.source] = delegatesTo[e.source] || []).push(e.target);
  }
});
Object.keys(delegatesTo).forEach(orch => {
  delegatesTo[orch].forEach(sub => {
    agentOutputSignificance[orch] = (agentOutputSignificance[orch] || 0) + (agentOutputSignificance[sub] || 0);
  });
});

function agentColor(a) {
  const base = statusColorMap[a.status] || statusColorMap.UNKNOWN;
  return a.is_subagent ? muteColor(base, 0.35) : base;
}

// Add Agents/Subagents — sized by the significance (subscriber count, rolled
// up through subagents and tools) of their outputs, not context load, so hubs
// that feed many downstream files stand out. Subagents cap smaller than
// top-level agents so hierarchy reads at a glance even before hovering.
data.agents.forEach(a => {
  const significance = agentOutputSignificance[a.name] || 0;
  const cap = a.is_subagent ? 20 : 30;
  const size = Math.max(7, Math.min(cap, 7 + Math.sqrt(significance) * 3.5));
  const isUnusedSubagent = a.is_subagent && !delegateTargets.has(a.name);
  const isIsolatedAgent = !a.is_subagent
    && (agentOutputSignificance[a.name] || 0) === 0
    && a.fan_in === 0 && a.fan_out === 0
    && !(delegatesTo[a.name] && delegatesTo[a.name].length);
  const unused = isUnusedSubagent || isIsolatedAgent;
  const color = unused ? PALETTE.unusedEntity : agentColor(a);
  graph.addNode(a.name, {
    x: Math.random() * 100, // layout pass overrides this
    y: Math.random() * 100,
    size: size,
    label: a.name,
    color: color,
    type: 'circle',
    metadata: {
      type: a.is_subagent ? 'subagent' : 'agent',
      status: a.status,
      model: a.model,
      temperature: a.temperature,
      output_significance: significance,
      unused: unused,
      critical: criticalSet.has(a.name)
    }
  });
});

// Format artifact labels for better readability
function formatArtifactLabel(path) {
  const domainsMatch = path.match(/domains\/(.*)/);
  if (domainsMatch) {
    return domainsMatch[1];
  }
  return path.split('/').pop();
}

// Add Artifacts — sized by subscriber count (how many agents read this file).
// Color encodes the artifact's role relative to the pipeline boundary, not a
// legitimacy verdict: normal / validated / external-input / external-output /
// unused-inside-pipeline. Whether an "unused" or "external" file is fine or a
// bug is left to the viewer to judge — this is a pre-run static analysis, so
// disk existence is not a reliable signal either way.
Object.keys(artifactMeta).forEach(artId => {
  if (!graph.hasNode(artId)) {
    const validators = lockedArtifacts.get(artId) || [];
    const locked = validators.length > 0;
    const flags = artifactFlags.get(artId) || {};
    const ext = isExternalPath(artId);
    const subs = subscriberCount(artId);
    const size = Math.max(4, Math.min(18, 4 + Math.sqrt(subs) * 4));

    let color = locked ? PALETTE.documentValidated : PALETTE.document;
    let category = locked ? 'documentValidated' : 'document';
    if (flags.no_producer) {
      color = PALETTE.externalInput; category = 'externalInput';
    } else if (flags.dead_end) {
      if (ext) {
        color = PALETTE.externalOutput; category = 'externalOutput';
      } else {
        color = PALETTE.documentUnused; category = 'documentUnused';
      }
    }

    const isStructured = /\.(yaml|yml|json)$/.test(artId);
    const needsValidator = isStructured && !locked && !flags.no_producer;

    graph.addNode(artId, {
      x: Math.random() * 100,
      y: Math.random() * 100,
      size: (flags.no_producer || flags.dead_end) ? Math.max(size, 8) : size,
      label: formatArtifactLabel(artId),
      color: color,
      metadata: {
        type: 'artifact',
        category: category,
        locked: locked,
        validated_by: validators,
        subscribers: subs,
        no_producer: !!flags.no_producer,
        dead_end: !!flags.dead_end,
        external: ext,
        needs_validator: needsValidator,
        critical: false // set below once criticalArtifacts is known
      }
    });
  }
});

const criticalArtifacts = new Set();
Object.keys(artifactMeta).forEach(art => {
  const hasCriticalWriter = (artifactWriters[art] ? [...artifactWriters[art]] : []).some(w => criticalSet.has(w));
  const hasCriticalReader = (artifactReaders[art] ? [...artifactReaders[art]] : []).some(r => criticalSet.has(r));
  if (hasCriticalWriter && hasCriticalReader) {
    criticalArtifacts.add(art);
  }
});
criticalArtifacts.forEach(art => {
  if (graph.hasNode(art)) graph.setNodeAttribute(art, 'metadata', { ...graph.getNodeAttribute(art, 'metadata'), critical: true });
});

// Unused tools: declared/discovered but no agent (directly or via composition)
// ever calls them.
const usedToolNames = new Set();
data.edges.forEach(e => {
  if (e.edge_type === 'uses_tool' || e.edge_type === 'calls_tool') usedToolNames.add(e.target);
});

// Add Edges
data.edges.forEach(e => {
  if (e.edge_type === 'loads_skill') return;
  if (e.source.includes('contracts/') || e.target.includes('contracts/')) return;
  if (e.source.includes('playbooks/') || e.target.includes('playbooks/')) return;

  if (e.edge_type === 'uses_tool' || e.edge_type === 'calls_tool') {
    if (!graph.hasNode(e.target)) {
      const t = toolMeta[e.target];
      const blastRadius = toolBlastRadius(e.target).size;
      const size = Math.max(6, Math.min(22, 6 + Math.sqrt(blastRadius) * 4));
      const isGenerator = !t || t.tool_type === 'generator' || t.tool_type === 'unknown';
      graph.addNode(e.target, {
        x: Math.random() * 100,
        y: Math.random() * 100,
        size: size,
        label: e.target,
        color: isGenerator ? PALETTE.toolGenerator : PALETTE.toolOther,
        metadata: {
          type: 'tool',
          tool_type: t ? t.tool_type : 'unknown',
          department: t ? t.department : '',
          blast_radius: blastRadius,
          critical: false
        }
      });
    }
  }

  if (graph.hasNode(e.source) && graph.hasNode(e.target)) {
    let isCritical = false;
    if (e.edge_type === 'delegates') {
      isCritical = criticalSet.has(e.source) && criticalSet.has(e.target);
    } else if (e.edge_type === 'writes') {
      isCritical = criticalSet.has(e.source) && criticalArtifacts.has(e.target);
    } else if (e.edge_type === 'produces') {
      isCritical = [...toolBlastRadius(e.source)].some(u => criticalSet.has(u)) && criticalArtifacts.has(e.target);
    } else if (e.edge_type === 'reads') {
      if (toolMeta[e.target] || toolUsers[e.target] || callersOfTool[e.target]) {
        isCritical = criticalArtifacts.has(e.source) && [...toolBlastRadius(e.target)].some(u => criticalSet.has(u));
      } else {
        isCritical = criticalArtifacts.has(e.source) && criticalSet.has(e.target);
      }
    }
    // uses_tool/calls_tool edges are left non-critical (default color): they
    // represent an agent invoking a tool, not a data dependency on the
    // critical path itself.

    const edgeId = `${e.source}->${e.target}`;
    if (!graph.hasEdge(edgeId)) {
      // Computed independently of isCritical: this is what the edge looks
      // like with critical-path highlighting off (the default — see
      // graph.html.j2's showCriticalPath). The magenta override is applied
      // on top of this by render.js.j2's edgeReducer only when the toggle is
      // on, so switching it doesn't require touching build-time colors again.
      let normalColor = '#1f2937'; // default gray-800
      if (e.edge_type === 'template_match') {
        normalColor = '#0ea5e9'; // sky-500 for template expansions
      } else if (e.edge_type === 'uses_tool') {
        normalColor = '#eab308'; // yellow-500
      } else if (e.edge_type === 'calls_tool') {
        normalColor = '#f59e0b'; // amber-500, tool -> tool composition
      } else if (e.edge_type === 'reads' && e.via_query_tool) {
        // Only the reads collapsed out of a read-only shared tool (see
        // graph.html.j2's readOnlyTools pass — any department's "query"-
        // style analyzer, not hardcoded to a specific tool name) get
        // highlighted: that's the one relationship worth calling out here.
        // A plain <read> tag straight from an agent to a file stays the
        // default color — coloring every reads edge green drowned this out.
        normalColor = PALETTE.readsEdge;
      } else if (e.edge_type === 'writes' || e.edge_type === 'produces') {
        // The flip side: what we write but then never read anywhere in this
        // department. Same color as the dead-end/external-output node itself
        // (see artifactFlags below), so the edge leading to it is flagged
        // without having to hover the node first.
        const flags = artifactFlags.get(e.target) || {};
        if (flags.dead_end) {
          normalColor = isExternalPath(e.target) ? PALETTE.externalOutput : PALETTE.documentUnused;
        } else {
          normalColor = e.edge_type === 'produces' ? '#ca8a04' : PALETTE.writesEdge;
        }
      } else if (e.is_optional) {
        normalColor = '#37415180'; // faint gray
      }
      graph.addEdgeWithKey(edgeId, e.source, e.target, {
        size: (isCritical && showCriticalPath) ? 2.5 : 1,
        color: (isCritical && showCriticalPath) ? PALETTE.criticalEdge : normalColor,
        type: 'arrow',
        metadata: { critical: isCritical, edge_type: e.edge_type, dead_end: !!(artifactFlags.get(e.target) || {}).dead_end, normal_color: normalColor }
      });
    }
  }
});

// Tools nobody calls — flag after edges are built so blast_radius/usage is final.
(data.tools || []).forEach(t => {
  if (graph.hasNode(t.name) && !usedToolNames.has(t.name)) {
    const md = graph.getNodeAttribute(t.name, 'metadata');
    graph.setNodeAttribute(t.name, 'metadata', { ...md, unused: true });
    graph.setNodeAttribute(t.name, 'color', PALETTE.unusedEntity);
  }
});
