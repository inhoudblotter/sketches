// --- Legend ---
// Kept deliberately short: every color here means one specific thing and
// appears in exactly one of the two groups below. Node-identity colors
// (tool type, document role) live in "Узлы"; what an edge is carrying lives
// in "Рёбра" — a color is only repeated across groups when it's the same
// fact seen from two ends (e.g. a dead-end write edge is colored like the
// dead-end node it points at, on purpose).
const legendItems = [
  ['#3b82f6', 'Агент (цвет = статус: done/ready/blocked/escalated)'],
  [muteColor('#3b82f6', 0.35), 'Сабагент (тот же статус, приглушённый тон)'],
  [PALETTE.document, 'Документ'],
  [PALETTE.documentValidated, 'Документ с валидацией (linter)'],
  [PALETTE.documentUnused, 'Создан в пайплайне, никем не читается'],
  [PALETTE.externalInput, 'Внешний вход (ничто в пайплайне это не производит)'],
  [PALETTE.externalOutput, 'Внешний выход (уходит за пределы workspace)'],
  [PALETTE.toolGenerator, 'Тул-генератор'],
  [PALETTE.toolOther, 'Тул (preprocessor/aggregator/analyzer)'],
  [PALETTE.unusedEntity, 'Неиспользуемый агент/сабагент/тул'],
];
const edgeLegendItems = [
  [PALETTE.readsEdge, 'Reads через общий read-only тул (query/analyzer) — реально потреблённые данные'],
  [PALETTE.writesEdge, 'Writes — записано и читается дальше по пайплайну'],
  [PALETTE.documentUnused, 'Writes → тупик: записано, но никто в отделе это не читает'],
  [PALETTE.externalOutput, 'Writes → внешний выход: уходит за пределы workspace, читают другие отделы'],
  ['#0ea5e9', 'Template expansion (плейсхолдер → конкретный файл)'],
  [PALETTE.criticalEdge, 'Критический путь пайплайна (кнопка "Critical Path" вверху — по умолчанию выключен)'],
];

const legendEl = document.getElementById('graph-legend');
legendEl.innerHTML =
  `<div class="text-gray-600 text-[10px] uppercase tracking-wide mb-1">Узлы</div>` +
  legendItems.map(([color, label]) =>
    `<div class="flex items-center gap-2"><span class="inline-block w-2.5 h-2.5 rounded-full flex-shrink-0" style="background:${color}"></span><span>${label}</span></div>`
  ).join('') +
  `<div class="text-gray-600 text-[10px] uppercase tracking-wide mt-3 mb-1">Рёбра</div>` +
  edgeLegendItems.map(([color, label]) =>
    `<div class="flex items-center gap-2"><span class="inline-block w-3 h-0.5 flex-shrink-0" style="background:${color}"></span><span>${label}</span></div>`
  ).join('');

// --- Issues panel: surfaces the architecture signals that are hard to spot
// purely from color at a glance (missing validators, unused entities). ---
const issues = [];

const unusedAgents = data.agents.filter(a => {
  if (a.is_subagent) return !delegateTargets.has(a.name);
  return (agentOutputSignificance[a.name] || 0) === 0 && a.fan_in === 0 && a.fan_out === 0
    && !(delegatesTo[a.name] && delegatesTo[a.name].length);
});
if (unusedAgents.length) {
  issues.push({
    title: `Неиспользуемые агенты/сабагенты (${unusedAgents.length})`,
    items: unusedAgents.map(a => a.name)
  });
}

const unusedTools = (data.tools || []).filter(t => !usedToolNames.has(t.name));
if (unusedTools.length) {
  issues.push({
    title: `Неиспользуемые тулы (${unusedTools.length})`,
    items: unusedTools.map(t => t.name)
  });
}

const needsValidator = [];
graph.forEachNode((node, attrs) => {
  if (attrs.metadata && attrs.metadata.type === 'artifact' && attrs.metadata.needs_validator) {
    needsValidator.push(node);
  }
});
if (needsValidator.length) {
  issues.push({
    title: `Структурированные данные без валидатора (${needsValidator.length})`,
    items: needsValidator.map(formatArtifactLabel)
  });
}

// Same amber/orange edges highlighted in the graph (see legend "Writes →
// тупик"/"Writes → внешний выход") collected into one scannable list: what
// gets written but never read anywhere inside this department's own pipeline.
const deadEndArtifacts = [];
graph.forEachNode((node, attrs) => {
  if (attrs.metadata && attrs.metadata.type === 'artifact' && attrs.metadata.dead_end) {
    deadEndArtifacts.push(node);
  }
});
if (deadEndArtifacts.length) {
  issues.push({
    title: `Записывается, но не читается внутри отдела (${deadEndArtifacts.length})`,
    items: deadEndArtifacts.map(formatArtifactLabel)
  });
}

const issuesEl = document.getElementById('graph-issues');
if (!issues.length) {
  issuesEl.innerHTML = `<div class="text-gray-600">Явных проблем не обнаружено.</div>`;
} else {
  issuesEl.innerHTML = issues.map(group => `
    <div>
      <div class="text-gray-400 mb-1">${group.title}</div>
      <div class="space-y-0.5 pl-1">
        ${group.items.slice(0, 12).map(name => `<div class="text-gray-500 truncate">· ${name}</div>`).join('')}
        ${group.items.length > 12 ? `<div class="text-gray-600">… и ещё ${group.items.length - 12}</div>` : ''}
      </div>
    </div>
  `).join('');
}
