{% import "screens/_macros.html.j2" as ui %}
{% call ui.page(cls="max-w-5xl") %}
  <div class="mb-8">
    <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">Artifacts</h2>
    <p class="text-gray-400 text-sm">External inputs/outputs and the department's internal artifact tree.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <div class="bg-[#0f0f0f] border border-gray-800 rounded-lg p-4">
      <h3 class="text-neon-blue font-semibold text-sm mb-3 uppercase tracking-wider">📥 External Inputs</h3>
      {% if report.metrics.external_inputs %}
      <ul class="space-y-1.5">
        {% for path in report.metrics.external_inputs %}
        <li class="text-xs text-gray-300 font-mono break-all">{{ path }}</li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="text-xs text-gray-500 italic">No external inputs.</p>
      {% endif %}
    </div>

    <div class="bg-[#0f0f0f] border border-gray-800 rounded-lg p-4">
      <h3 class="text-neon-emerald font-semibold text-sm mb-3 uppercase tracking-wider">📤 External Outputs</h3>
      {% if report.metrics.external_outputs %}
      <ul class="space-y-1.5">
        {% for path in report.metrics.external_outputs %}
        <li class="text-xs text-gray-300 font-mono break-all">{{ path }}</li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="text-xs text-gray-500 italic">No external outputs.</p>
      {% endif %}
    </div>
  </div>

  <div class="bg-[#0f0f0f] border border-gray-800 rounded-lg p-4 mb-8">
    <div class="flex justify-between items-center mb-3">
      <h3 class="text-neon-cyan font-semibold text-sm uppercase tracking-wider">🛡️ Linter Coverage</h3>
      <span class="text-xs font-mono font-bold px-2 py-1 rounded bg-gray-800 {{ 'text-neon-emerald' if report.metrics.output_contract_coverage_pct >= 90 else ('text-yellow-400' if report.metrics.output_contract_coverage_pct >= 50 else 'text-red-400') }}">{{ report.metrics.output_contract_coverage_pct }}%</span>
    </div>
    <p class="text-xs text-gray-400 mb-3">Share of department output files (generated by agent or tool) that are verified by at least one linter.</p>
    
    {% set output_artifacts = report.artifacts | selectattr('producers') | list %}
    {% set uncovered = output_artifacts | rejectattr('locked') | list %}
    {% if uncovered %}
    <p class="text-xs text-gray-300 font-semibold mb-1.5">Not covered by linters:</p>
    <ul class="space-y-1.5 max-h-48 overflow-y-auto pr-2 no-scrollbar">
      {% for a in uncovered %}
      <li class="text-xs text-red-400 font-mono break-all">- {{ a.path }}</li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="text-xs text-neon-emerald italic">All output artifacts are covered by linters.</p>
    {% endif %}
  </div>

  <div class="bg-[#0f0f0f] border border-gray-800 rounded-lg p-4">
    <h3 class="text-white font-semibold text-sm mb-3 uppercase tracking-wider">🗂️ Internal Artifact Tree</h3>
    <pre class="text-xs text-gray-300 font-mono whitespace-pre overflow-x-auto">{{ report.artifact_tree }}</pre>
  </div>
{% endcall %}
