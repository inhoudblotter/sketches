{% import "screens/_macros.html.j2" as ui %}
{% call ui.page(cls="max-w-4xl") %}
  <div class="mb-8">
    <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">Workflow Execution Plan</h2>
    <p class="text-gray-400 text-sm">Topological sort of orchestrator dependencies. Agents within the same stage can be executed in parallel.</p>
  </div>

  <div class="relative border-l-2 border-gray-800 ml-4 pl-6 sm:pl-8 space-y-10 sm:space-y-12">
    {% for stage in report.execution_stages %}
    <div class="relative">
      <!-- Milestone Dot -->
      <div class="absolute -left-[33px] sm:-left-[41px] top-1 w-4 h-4 rounded-full bg-venture-dark border-2 border-neon-cyan shadow-[0_0_8px_rgba(0,243,255,0.8)] z-10"></div>

      <!-- Stage Header -->
      <h3 class="text-neon-cyan font-semibold text-lg mb-4 flex flex-wrap items-center gap-3">
        STAGE {{ stage.stage_number }}
        <span class="text-xs font-normal text-gray-500 bg-gray-900 px-2 py-0.5 rounded border border-gray-800">Parallel Executions</span>
      </h3>

      <!-- Agents Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {% for agent in stage.parallel_agents %}
        {% set border_color = ui.status_classes(agent.status).strip().split('|')[1] %}

        <div class="bg-[#0f0f0f] border {{ border_color }} rounded-lg p-4 shadow-sm hover:shadow-[0_0_10px_rgba(0,0,0,0.5)] transition-all">
          <div class="flex justify-between items-start mb-3">
            <h4 class="font-bold text-white text-md">{{ agent.name }}</h4>
            {{ ui.status_pill(agent.status) }}
          </div>

          {% if agent.subagents %}
          <div class="mt-4 pt-3 border-t border-gray-800">
            <span class="text-xs text-gray-500 mb-2 block uppercase tracking-wider">Delegates to (Subagents):</span>
            <div class="flex flex-wrap gap-2">
              {% for subagent in agent.subagents %}
              <div class="flex items-center gap-1.5 px-2 py-1 rounded bg-[#171717] border border-gray-700 text-xs text-gray-300">
                <svg class="w-3 h-3 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                {{ subagent }}
              </div>
              {% endfor %}
            </div>
          </div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
{% endcall %}
